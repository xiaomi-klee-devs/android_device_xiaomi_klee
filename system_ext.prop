# Audio
ro.audio.silent=0
ro.audio.flinger_standbytime_ms=2000
ro.audio.ihaladaptervendorextension_enabled=true
ro.audio.usb.period_us=16000
ro.camera.sound.forced=0

# Radio
ro.fota.oem=Xiaomi
ro.radio.device_type=1
ro.vendor.imeisv=03
ro.vendor.mtk_gwsd_support=1
ro.vendor.mtk_telephony_add_on_policy=0
ro.vendor.vodata_support=1
vendor.rild.libargs=-d /dev/ttyC0
vendor.rild.libpath=mtk-ril.so

# Versioning
ro.mi.os.version.code=3
ro.mi.os.version.incremental=OS3.0.307.0.WPJMIXM

# Wifi
wifi.direct.interface=p2p0
wifi.interface=wlan0
wifi.tethering.interface=ap0

# RKPD
remote_provisioning.enable_rkpd=true
remote_provisioning.hostname=remoteprovisioning.googleapis.com
remote_provisioning.hostname.default=remoteprovisioning.googleapis.com
remote_provisioning.hostname.strongbox=remoteprovisioning.googleapis.com
remote_provisioning.connect_timeout_millis=2000
remote_provisioning.download_csr_timeout_millis=10000
