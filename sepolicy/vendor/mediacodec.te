#
# Dolby Vision decode path sepolicy rules for klee (MT6899).
#
# Every denial below was captured immediately before the recurring crash in
# vendor.dolby.media.c2-service-vision (mediacodec domain) during Dolby
# Vision playback: DolbyEGLContext acquisition succeeds, but the buffer
# import/metadata path fails (mali_gralloc "bad handle", GraphicBufferMapper
# importBuffer failed: 2, EGL Image creation failed), which eventually
# terminates the Mali GPU firmware context (Unhandled Page fault) and
# produces a black screen / SurfaceFlinger BAD_LAYER.
# The base MTK vendor sepolicy (android_device_mediatek_sepolicy_vndr)
# does not cover any of these - they are Dolby Vision proprietary-layer
# specific and normally shipped as closed-source sepolicy by the OEM.

# --- Dolby Media System (DMS) binder access ---
# From xiaomi-goya-devs/android_device_xiaomi_goya "goya: Add Dolby Vision
# support" (a3798c1). Lets mediacodec (vendor.dolby.media.c2-service-vision)
# reach vendor.dolby.dms.service over binder.
allow mediacodec hal_aidl_dms_service:service_manager find;

binder_call(mediacodec, hal_aidl_dms_default)
binder_use(mediacodec)

# --- Panel brightness (used by Dolby Vision tone-mapping) ---
# avc: denied { read } for name="brightness_clone" dev="sysfs"
#   scontext=u:r:mediacodec:s0 tcontext=u:object_r:vendor_displayfeature_sysfs:s0 tclass=file
# NOTE (2026-08-17): confirmed via `sesearch` against the factory
# odm/etc/selinux/precompiled_sepolicy that mediacodec does NOT read this
# sysfs node directly there. Instead, the factory grants:
#   allow hal_codec2_server vendor_hal_displayfeature_xiaomi_default:fd use;
# where "hal_codec2_server" is an attribute whose members include
# mediacodec, mediaswcodec, mtk_hal_c2 and vendorcodec (confirmed via
# `seinfo --attribute=hal_codec2_server -x`). The actual sysfs read is
# done by the vendor.xiaomi.hardware.displayfeature_aidl-service daemon
# (domain vendor_hal_displayfeature_xiaomi_default, see
# device/xiaomi/klee/sepolicy/vendor/hal_displayfeature_xiaomi.te), which
# hands mediacodec an already-open file descriptor over binder rather than
# mediacodec opening the sysfs file itself. This device tree does not
# currently define a hal_codec2_server attribute, so the rule is added
# directly against mediacodec instead of via attribute membership.
allow mediacodec vendor_hal_displayfeature_xiaomi_default:fd use;
# Fallback in case the fd-passing path is ever bypassed and mediacodec
# does try to read the sysfs node directly (matches the literal AVC denial
# above) - harmless if unused, since the factory path is fd use, not this.
allow mediacodec vendor_displayfeature_sysfs:dir search;
allow mediacodec vendor_displayfeature_sysfs:file r_file_perms;

# --- Graphics config properties ---
# avc: denied { read } for name="u:object_r:graphics_config_writable_prop:s0"
#   dev="tmpfs" scontext=u:r:mediacodec:s0 tclass=file
get_prop(mediacodec, graphics_config_writable_prop)

# avc: denied { read } for name="u:object_r:default_prop:s0"
#   dev="tmpfs" scontext=u:r:mediacodec:s0 tclass=file
# (seen repeatedly per decoder instance, both DvPreLooper and DvPostLooper)
# NOTE (2026-08-17): get_prop(mediacodec, default_prop) was tried here first,
# but it violates an AOSP neverallow rule (system/sepolicy/private/property.te:164
# and public/property.te:272 - "neverallow ... default_prop (file ...)") and
# fails the build with a neverallow check failure. This retroactively confirms
# the factory-policy finding below: the shipped Xiaomi build never grants plain
# default_prop to mediacodec either, only vendor_default_prop. Do not re-add
# get_prop(mediacodec, default_prop) - it cannot pass the AOSP neverallow check.
# The factory policy actually grants "vendor_default_prop" (not plain
# default_prop) to mediacodec - 300 rules reference this type there.
get_prop(mediacodec, vendor_default_prop)

# --- dmabuf fd handling for EGL image creation / gralloc metadata import ---
# avc: denied { getattr } for name="/" dev="dmabuf" ino=1
#   scontext=u:r:mediacodec:s0 tcontext=u:object_r:unlabeled:s0 tclass=filesystem
# This denial directly precedes "mali_gralloc: bad handle" / "Mapper error: 2"
# / "EGL Setup: Failed to create EGL Image" / GPU MMU page fault in the log -
# the metadata query on the dmabuf fd fails, the buffer handle never gets
# properly validated/imported, and the GPU eventually faults on it.
allow mediacodec unlabeled:filesystem getattr;

# --- Ambient light sensor (adaptive brightness for Dolby Vision) ---
# avc: denied { find } for name=android.frameworks.sensorservice.ISensorManager/default
#   scontext=u:r:mediacodec:s0 tcontext=u:object_r:fwk_sensor_service:s0 tclass=service_manager
# Corresponds to logcat: "DolbySensorReader: error, ASensorManager_getInstance"
#                        "DolbySensorReader: error, Light Sensor init failed"
allow mediacodec fwk_sensor_service:service_manager find;
binder_call(mediacodec, system_server)

# --- Mali GPU compression HAL (used by DolbyEGLProcessing/GraphicBuffer path) ---
# avc: denied { find } for name=arm.mali.platform.ICompression/default
#   scontext=u:r:mediacodec:s0 tcontext=u:object_r:mtk_hal_mali_platform_default_service:s0 tclass=service_manager
# NOTE: only mtk_hal_camera.te references this service type in the device tree
# (as a client, via find). No .te file in device/xiaomi/klee/sepolicy, vendor/mediatek
# or hardware/mediatek defines/owns this type with an explicit domain - it is likely
# shipped as a prebuilt vendor sepolicy blob (CIL) outside source control. Granting
# only "find" here; do NOT add binder_call() until the actual server-side domain is
# confirmed - guessing the wrong domain in binder_call() would fail the build with
# an undefined type error.
allow mediacodec mtk_hal_mali_platform_default_service:service_manager find;
