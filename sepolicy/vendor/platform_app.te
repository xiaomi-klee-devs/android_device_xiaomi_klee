binder_call(platform_app, hal_fingerprint_default)

hal_client_domain(platform_app, hal_touchfeature_xiaomi)
allow platform_app vendor_hal_fingerprint_service_xiaomi:service_manager find;
allow platform_app hal_dynamic_camera_service:service_manager find;

# Camera
r_dir_file(platform_app, vendor_camera_data_file)
allow platform_app privapp_data_file:file execute;

get_prop(platform_app, vendor_display_type_prop)
get_prop(platform_app, vendor_us_proximity_prop)

# Fingerprint
binder_call(platform_app, hal_fingerprint_default)
get_prop(platform_app, vendor_fingerprint_prop)

allow platform_app fingerprint_vendor_data_file:file { read };