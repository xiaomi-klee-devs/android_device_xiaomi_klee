set_prop(mtk_hal_pq, vendor_displayfeature_prop)
allow mtk_hal_pq vendor_hal_displayfeature_default:fd use;
allow mtk_hal_pq vendor_displayfeature_device:chr_file { ioctl read write open };
allow mtk_hal_pq vendor_displayfeature_sysfs:dir { read open search };
allow mtk_hal_pq vendor_displayfeature_sysfs:file { read write getattr open };
allow mtk_hal_pq mnt_vendor_file:dir search;

